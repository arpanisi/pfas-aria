# ─────────────────────────────────────────────────────────────────────────────
# PFAS-ARIA Environment Variables
# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Render managed Postgres) ───────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/pfas_aria

# ── Auth (Clerk) ──────────────────────────────────────────────────────────────
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# ── LLM (only needed when using RunPod) ──────────────────────────────────────
RUNPOD_ENDPOINT=https://your-runpod-endpoint/v1

# ── Literature APIs ───────────────────────────────────────────────────────────
# arXiv requires no key — it's open
# Semantic Scholar — optional, higher rate limits with key
SEMANTIC_SCHOLAR_API_KEY=

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development    # development | production
LOG_LEVEL=INFO
