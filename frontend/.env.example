# Clerk publishable key (safe to expose — it's meant to be public)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# API base URL — in dev, Vite proxies /api to localhost:8000
# In production, set this to your Render backend URL
VITE_API_URL=/api

# WebSocket base URL
VITE_WS_URL=ws://localhost:8000
